DB_NAME=efsanebaharat
DB_USER=efsanebaharat
DB_PASS=degistir_beni
DB_ROOT_PASS=kok_sifre_degistir

# Cloudflare R2 (Dashboard > R2 > Manage R2 API Tokens: "Object Read & Write", iki kovaya da yetki)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Ürün resimleri kovası: herkese açık erişim açık olmalı (r2.dev veya özel alan adı)
R2_BUCKET=efsane-resimler
R2_PUBLIC_URL=https://cdn.ornek-alanadi.com
# Veritabanı yedekleri kovası: GİZLİ kalmalı, herkese açık erişim AÇILMAMALI
R2_BACKUP_BUCKET=efsane-yedekler
R2_YEDEK_SAKLAMA_GUN=30
