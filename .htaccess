DirectoryIndex index.php index.html
Options -Indexes

<Files 403.shtml>
    Require all granted
</Files>

# Hassas dosyaları web üzerinden erişime kapat (SQL dökümleri, loglar, ortam/yapılandırma, dokümanlar)
<FilesMatch "(?i)(\.(sql|log|md|env|ini|bak|old|backup|sh|yml|yaml|lock|dist|xml)|^(Dockerfile|composer\.json|package(-lock)?\.json|phpunit\.xml(\.dist)?|\.env.*|\.git.*|\.cursorrules|\.dockerignore|\.htaccess))$">
    Require all denied
</FilesMatch>

# Sunucu tarafı yardımcı dizinlere doğrudan erişimi engelle
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(cron|\.git|\.codex-remote-attachments|\.claude|\.kiro|db-init|sql|scratch|tests|logs|temp|yedek|node_modules|vendor)(/|$) - [F,L]
    RewriteRule ^includes/ - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
    Header always unset X-Powered-By
</IfModule>
