# Yüklenen dosyalar asla sunucu tarafında çalıştırılmaz
Options -Indexes -ExecCGI
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|cgi|pl|py|sh|shtml|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
